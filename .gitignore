# Secrets et identifiants
.env
.env.*
*.key
*.pem
*.pfx
*.p12
*.cer
*.crt
*.kdbx
secrets.*
credentials.*

# Documents sensibles
*_confidentiel.*
*_confidential.*
*_client.*
*_production.*
*_prod.*
*_final-client.*

# Sauvegardes, archives et bases
*.bak
*.bkp
*.backup
*.sql
*.db
*.sqlite
*.zip
*.7z
*.rar

# Journaux et captures
*.log
logs/
screenshots/private/

# Fichiers temporaires Office
~$*
*.tmp
*.temp

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/

# IDE
.vscode/
.idea/

# Génération locale
build/
exports/
output/
dist/

# Réglages locaux de l'outillage : ils ne doivent dépendre d'aucune discipline
# de `git add`.
.claude/settings.local.json
.claude/settings.local.json.*

# Système
Thumbs.db
Desktop.ini
.DS_Store
