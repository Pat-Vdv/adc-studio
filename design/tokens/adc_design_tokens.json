{
  "meta": {
    "name": "ADC Design System",
    "version": "0.4.1",
    "status": "candidate",
    "scope": [
      "Word",
      "PDF"
    ]
  },
  "colors": {
    "primary": "#17365D",
    "primary_light": "#DCE6F1",
    "accent": "#2F75B5",
    "accent_light": "#EAF2F8",
    "ink": "#1F2933",
    "muted": "#5F6B76",
    "line": "#D9E2F3",
    "surface": "#F6F8FB",
    "white": "#FFFFFF",
    "success": "#2E7D32",
    "warning": "#B26A00",
    "danger": "#B42318",
    "info": "#2F75B5"
  },
  "typography": {
    "font_family": {
      "display": "Aptos Display",
      "body": "Aptos",
      "mono": "Consolas"
    },
    "sizes_pt": {
      "cover_title": 28,
      "cover_subtitle": 14,
      "heading_1": 20,
      "heading_2": 15,
      "heading_3": 12,
      "body": 10.5,
      "caption": 8.5,
      "code": 9
    },
    "line_spacing": {
      "body": 1.15,
      "compact": 1.0
    }
  },
  "page": {
    "size": "A4",
    "margins_cm": {
      "top": 2.0,
      "bottom": 1.8,
      "left": 2.2,
      "right": 1.8
    },
    "header_cm": 0.9,
    "footer_cm": 0.9
  },
  "spacing_pt": {
    "paragraph_after": 6,
    "heading_1_before": 18,
    "heading_1_after": 8,
    "heading_2_before": 14,
    "heading_2_after": 6,
    "component_gap": 10
  },
  "components": {
    "callout": {
      "types": [
        "information",
        "validation",
        "attention",
        "critique",
        "recommendation"
      ],
      "border_width_pt": 2.5,
      "padding_pt": 8
    },
    "table": {
      "header_fill": "#17365D",
      "header_text": "#FFFFFF",
      "alternate_fill": "#F6F8FB"
    },
    "finding": {
      "id_format": "F-{number:03d}",
      "sections": [
        "Observation",
        "Impact",
        "Evidence",
        "Conclusion"
      ]
    },
    "recommendation": {
      "id_format": "R-{number:03d}",
      "sections": [
        "Priority",
        "Effort",
        "Action",
        "Expected result"
      ]
    }
  }
}